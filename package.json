{
  "name": "miva-reel-studio",
  "version": "0.1.0",
  "description": "Desktop app lokal untuk edit Reels talking-head MIVA",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "golden": "python3 tests/parity/gen_golden.py",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && xvfb-run -a node tests/e2e.smoke.mjs",
    "postinstall": "node scripts/prepare-render-assets.mjs",
    "fetch-resources": "node scripts/fetch-resources.mjs",
    "e2e": "electron-vite build && xvfb-run -a vitest run -c vitest.e2e.config.ts",
    "test:offline": "unshare -n python3 tests/tools/offline.py npx vitest run tests/render tests/core/whisper",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatminagent-afk/miva-reel-studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chatminagent-afk/miva-reel-studio/issues"
  },
  "homepage": "https://github.com/chatminagent-afk/miva-reel-studio#readme",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "extract-zip": "2.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.84",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "MIVA Reel Studio"
}
